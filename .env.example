# This browser-only site does not require secrets to run.
# For live lead capture, configure a public HTTPS endpoint that accepts the
# InquiryFormData JSON payload:
# VITE_INQUIRY_ENDPOINT="https://your-domain.example/api/inquiries"
#
# The local CMS preview is available only during development. If you need it,
# configure credentials in a local .env file and never expose them in a
# production build:
# VITE_ADMIN_EMAIL="admin@example.com"
# VITE_ADMIN_PASSWORD="replace-with-a-long-local-password"
